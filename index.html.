.btn{display:inline-block;margin-top:20px;padding:15px 22px;background:#a78bfa;color:#090b10;text-decoration:none;font-weight:bold;border-radius:7px}

section{padding:55px 7%}

h2{font-size:30px}

.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:15px}

.card{padding:24px;background:#121620;border:1px solid #2a2e3b;border-radius:12px}

.card b{font-size:19px}

.symbol{font-size:35px;margin-bottom:18px}

.contact{text-align:center;background:#12101b}

